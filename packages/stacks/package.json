{
  "name": "@bughq/stacks",
  "type": "module",
  "version": "0.2.2",
  "description": "bughq error tracking for Stacks apps — installed as a log transport",
  "license": "MIT",
  "homepage": "https://bughq.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/bughq/sdk.git",
    "directory": "packages/stacks"
  },
  "keywords": ["bughq", "error-tracking", "stacks", "logging", "transport", "bun"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @bughq/sdk --external @stacksjs/logging --external @stacksjs/router --external @stacksjs/queue",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bughq/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@stacksjs/logging": ">=0.72.76"
  },
  "peerDependenciesMeta": {
    "@stacksjs/logging": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
